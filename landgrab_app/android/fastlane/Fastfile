default_platform(:android)

# Load secrets if present. Real values live in .env.fastlane (gitignored);
# .env.fastlane.example documents what should be set.
env_file = File.expand_path(".env.fastlane", __dir__)
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    next if line.strip.empty? || line.start_with?("#")
    key, value = line.strip.split("=", 2)
    ENV[key] ||= value if key && value
  end
end

ALPHA_API_ROOT      = "https://poles-staging.chromatin.ca"
PRODUCTION_API_ROOT = "https://landgrab.chromatin.ca"
FLUTTER_PROJECT_DIR = File.expand_path("../..", __dir__)
AAB_DIR             = File.join(FLUTTER_PROJECT_DIR, "build/app/outputs/bundle/release")

def find_aab
  aab = Dir.glob(File.join(AAB_DIR, "*.aab")).max_by { |f| File.mtime(f) }
  UI.user_error!("No .aab found in #{AAB_DIR} — did flutter build appbundle succeed?") if aab.nil?
  aab
end

# Play Store version codes must be unique across the WHOLE app, not
# per track — so the next code is one past the highest code on ANY
# track (internal / alpha / beta / production), never just the track
# we're uploading to. (Looking at a single track let `alpha` reuse a
# code `beta` had already pushed to the Alpha track.) commit_count is
# a floor so numbers only ever climb.
def next_build_number
  commit_count = `git rev-list --count HEAD`.strip.to_i
  key = File.expand_path(ENV.fetch("PLAY_JSON_KEY_PATH"))

  codes =
    %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(
        package_name: "ca.chromatin.poles",
        track: track,
        json_key: key
      )
    rescue StandardError => e
      # A track with no release yet raises — treat as no codes.
      UI.message("No version codes on track '#{track}': #{e.message}")
      []
    end

  latest = codes.compact.max || 0
  [commit_count, latest + 1].max
end

def flutter_build_aab(flavor:, api_root:, sentry_dsn:, build_number:)
  Dir.chdir(FLUTTER_PROJECT_DIR) do
    sh(
      "flutter", "build", "appbundle",
      "--build-number=#{build_number}",
      "--dart-define=FLAVOR_NAME=#{flavor}",
      "--dart-define=API_ROOT=#{api_root}",
      "--dart-define=SENTRY_DSN=#{sentry_dsn}"
    )
  end
end

platform :android do
  desc "Build with alpha flavor (staging API) and upload to Play Internal Testing"
  lane :alpha do
    build_number = next_build_number
    flutter_build_aab(
      flavor: "alpha",
      api_root: ALPHA_API_ROOT,
      sentry_dsn: ENV.fetch("SENTRY_DSN", ""),
      build_number: build_number
    )
    upload_to_play_store(
      aab: find_aab,
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # The ATTENDEE build: production API, uploaded to the closed-testing
  # track whose Play Console identifier is "alpha" (shown there as
  # "Closed testing - Alpha"). Attendees join that track via the
  # Google Group's opt-in link. NB the naming clash: this Fastlane
  # *lane* is `beta` (alpha=staging dogfood → beta=real attendees →
  # production=store), but the Play *track* it targets is named
  # "alpha". Closed testing is reviewed, so submit ahead of the event
  # rather than relying on a same-day upload clearing review.
  desc "Build with production flavor (production API) and upload to Play closed testing (Alpha track) — the attendee build."
  lane :beta do
    build_number = next_build_number
    flutter_build_aab(
      flavor: "production",
      api_root: PRODUCTION_API_ROOT,
      sentry_dsn: ENV.fetch("SENTRY_DSN", ""),
      build_number: build_number
    )
    upload_to_play_store(
      aab: find_aab,
      track: "alpha",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Push Play Store listing metadata (title, short/full description, video) without uploading a build."
  desc "Reads from fastlane/metadata/android/<locale>/<field>.txt — only files present get pushed; everything else stays as-is in Play Console."
  lane :metadata do
    key = File.expand_path(ENV.fetch("PLAY_JSON_KEY_PATH"))

    # supply won't push listing metadata unless it can pin the edit to an
    # existing release: with no build in this lane it falls back to an empty
    # version_code and errors ("Could not find release for version code ''").
    # The store listing is app-global, so any track with a release works —
    # find the first that has one (internal first: the alpha lane feeds it).
    track, version_code =
      %w[internal alpha beta production].filter_map do |t|
        code = google_play_track_version_codes(
          package_name: "ca.chromatin.poles",
          track: t,
          json_key: key
        ).max
        [t, code] if code
      rescue StandardError
        nil
      end.first

    UI.user_error!("No release found on any track — can't anchor a metadata-only upload. Push a build first (fastlane alpha).") if version_code.nil?

    upload_to_play_store(
      package_name: "ca.chromatin.poles",
      json_key: key,
      track: track,
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # No `production` (public Play Store) lane: this is a private event,
  # distributed via closed testing (see `beta`). If a public release
  # is ever wanted, add a lane uploading to `track: "production"` —
  # see docs/beta-distribution.md's "public release" section.
end
