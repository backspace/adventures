# Copy to .env.fastlane (gitignored) and fill in real values.

# App Store Connect API key — App Store Connect → Users and Access → Integrations
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Apple Developer team ID — Apple Developer portal, top right
APPLE_TEAM_ID=

# Sentry DSN — single Flutter project; alpha vs production is differentiated
# by the environment tag set in main.dart, not by the DSN. Optional.
SENTRY_DSN=

# Where the in-app "update available" banner sends players to fetch a newer
# build — the public TestFlight link. Same value as the server's
# ONBOARDING_IOS_INSTALL. Baked in via --dart-define (never committed).
# Optional — if empty, the banner still shows but without an Update button.
IOS_INSTALL_URL=

# TestFlight tester groups, comma-separated, names matching App Store
# Connect → TestFlight EXACTLY. Split by channel because internal and
# external can't be mixed on one build:
#   - INTERNAL: used by `fastlane ios alpha` (staging dogfood). The
#     names under "Internal Testing". Optional — internal testers can
#     access builds without an explicit group.
#   - EXTERNAL: used by `fastlane ios beta` (attendee build). The name
#     of the "External Testing" group that has the public link on.
TESTFLIGHT_INTERNAL_GROUPS=
TESTFLIGHT_EXTERNAL_GROUPS=

# "What to test" note shown to external testers. Required by App Store
# Connect for external distribution; the `beta` lane sends it.
# Optional — defaults to "Bug fixes and improvements."
TESTFLIGHT_CHANGELOG=
