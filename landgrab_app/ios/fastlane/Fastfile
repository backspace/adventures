default_platform(:ios)

# Load secrets if present. Real values live in .env.fastlane (gitignored);
# .env.fastlane.example documents what should be set.
env_file = File.expand_path(".env.fastlane", __dir__)
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    next if line.strip.empty? || line.start_with?("#")
    key, value = line.strip.split("=", 2)
    ENV[key] ||= value if key && value
  end
end

ALPHA_API_ROOT      = "https://poles-staging.chromatin.ca"
PRODUCTION_API_ROOT = "https://landgrab.chromatin.ca"
FLUTTER_PROJECT_DIR = File.expand_path("../..", __dir__)
IPA_DIR             = File.join(FLUTTER_PROJECT_DIR, "build/ios/ipa")

def find_ipa
  ipa = Dir.glob(File.join(IPA_DIR, "*.ipa")).max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa found in #{IPA_DIR} — did flutter build ipa succeed?") if ipa.nil?
  ipa
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"))
  )
end

def next_build_number
  commit_count = `git rev-list --count HEAD`.strip.to_i
  # `app_store_build_number` with live:false sees every build known to
  # App Store Connect — including ones still processing or already
  # rejected — so we never collide with an in-flight upload the way
  # `latest_testflight_build_number` did.
  latest = app_store_build_number(
    api_key: asc_api_key,
    app_identifier: "ca.chromatin.poles",
    live: false,
    initial_build_number: 0
  )
  [commit_count, latest + 1].max
end

def flutter_build_ipa(flavor:, api_root:, sentry_dsn:)
  build_number = next_build_number
  Dir.chdir(FLUTTER_PROJECT_DIR) do
    sh(
      "flutter", "build", "ipa",
      "--build-number=#{build_number}",
      "--export-options-plist=ios/ExportOptions.plist",
      "--dart-define=FLAVOR_NAME=#{flavor}",
      "--dart-define=API_ROOT=#{api_root}",
      "--dart-define=SENTRY_DSN=#{sentry_dsn}"
    )
  end
end

# Upload the freshly-built IPA to TestFlight and assign it to the
# groups in TESTFLIGHT_GROUPS.
#
# external: true is what puts a build in front of the public-link
# "Event attendees" group. It requires a `changelog` ("what to test")
# and submits the build for Beta App Review — the first external
# build waits ~24-48h; later ones usually auto-clear. external: false
# is the internal path (staging dogfood): no review, available in
# minutes, but only to internal testers on the App Store Connect team.
def deliver_to_testflight(external:)
  # Internal and external groups are separate channels and can't be
  # mixed on one build, so each lane reads its own var. Names must
  # match App Store Connect → TestFlight exactly (Internal Testing vs
  # External Testing group names).
  var = external ? "TESTFLIGHT_EXTERNAL_GROUPS" : "TESTFLIGHT_INTERNAL_GROUPS"
  groups = ENV.fetch(var, "").split(",").map(&:strip).reject(&:empty?)

  upload_to_testflight(
    api_key: asc_api_key,
    ipa: find_ipa,
    groups: groups,
    distribute_external: external,
    # Required by App Store Connect for external distribution; harmless
    # for internal. Override per-build via TESTFLIGHT_CHANGELOG.
    changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Bug fixes and improvements."),
    skip_waiting_for_build_processing: false
  )
rescue Spaceship::UnexpectedResponse => e
  raise unless e.message.include?("Cannot add internal group to a build")
  UI.important("TestFlight returned a known false-positive on internal group assignment.")
  UI.important("The build was uploaded and the group is assigned — verify in App Store Connect.")
end

platform :ios do
  # Fastlane's default failure banner scrolls off the top of the
  # terminal during long IPA builds — make it impossible to miss by
  # firing a macOS notification (pops up in Notification Center) and
  # a spoken cue. `terminal-notifier` is bundled with fastlane so
  # the `notification` action works out of the box
  after_all do |lane|
    UI.header("✅ #{lane} succeeded")
    notification(
      title: "LANDGRAB #{lane}",
      subtitle: "Succeeded",
      message: "Build + upload complete."
    )
  end

  error do |lane, exception|
    UI.header("❌ #{lane} FAILED")
    UI.error(exception.message)
    notification(
      title: "LANDGRAB #{lane}",
      subtitle: "FAILED",
      message: exception.message.lines.first.to_s.strip
    )
  end

  desc "Build with alpha flavor (staging API) and upload to TestFlight internal testers (staging dogfood, no review)."
  lane :alpha do
    flutter_build_ipa(
      flavor: "alpha",
      api_root: ALPHA_API_ROOT,
      sentry_dsn: ENV.fetch("SENTRY_DSN", "")
    )
    deliver_to_testflight(external: false)
  end

  desc "Push App Store Connect listing metadata (name, subtitle, description, etc.) without uploading a build."
  desc "Reads from fastlane/metadata/<locale>/<field>.txt — only files present get pushed; everything else stays as-is in App Store Connect."
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "ca.chromatin.poles",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  # The ATTENDEE build. Named `beta` to match Android and to be
  # honest: this goes to external *testers* via TestFlight, not the
  # public App Store. (The build still uses the "production" Flutter
  # flavor — real server, env switcher hidden.) There's deliberately
  # no `production`/store-release lane: we're not releasing publicly.
  desc "Build with production flavor (production API) and upload to TestFlight external testers — the attendee build."
  desc "Distributes to the external (public-link) group and submits for Beta App Review; first build waits, later ones usually auto-clear."
  lane :beta do
    flutter_build_ipa(
      flavor: "production",
      api_root: PRODUCTION_API_ROOT,
      sentry_dsn: ENV.fetch("SENTRY_DSN", "")
    )
    deliver_to_testflight(external: true)
  end
end
