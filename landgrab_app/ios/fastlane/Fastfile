default_platform(:ios)

# Load secrets if present. Real values live in .env.fastlane (gitignored);
# .env.fastlane.example documents what should be set.
env_file = File.expand_path(".env.fastlane", __dir__)
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    next if line.strip.empty? || line.start_with?("#")
    key, value = line.strip.split("=", 2)
    ENV[key] ||= value if key && value
  end
end

PRODUCTION_API_ROOT = "https://landgrab.chromatin.ca"
FLUTTER_PROJECT_DIR = File.expand_path("../..", __dir__)
IPA_DIR             = File.join(FLUTTER_PROJECT_DIR, "build/ios/ipa")

def find_ipa
  ipa = Dir.glob(File.join(IPA_DIR, "*.ipa")).max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa found in #{IPA_DIR} — did flutter build ipa succeed?") if ipa.nil?
  ipa
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"))
  )
end

def next_build_number
  commit_count = `git rev-list --count HEAD`.strip.to_i
  # `app_store_build_number` with live:false sees every build known to
  # App Store Connect — including ones still processing or already
  # rejected — so we never collide with an in-flight upload the way
  # `latest_testflight_build_number` did.
  latest = app_store_build_number(
    api_key: asc_api_key,
    app_identifier: "ca.chromatin.poles",
    live: false,
    initial_build_number: 0
  )
  [commit_count, latest + 1].max
end

def flutter_build_ipa(flavor:, api_root:, sentry_dsn:)
  # Fail fast rather than silently shipping a build with crash reporting
  # disabled. This Fastfile auto-loads ios/fastlane/.env.fastlane (see the
  # top of the file), so an empty DSN here means that file is missing or
  # has no SENTRY_DSN — see .env.fastlane.example.
  if sentry_dsn.to_s.strip.empty?
    UI.user_error!("SENTRY_DSN is empty — Sentry would be disabled in this build. Set SENTRY_DSN in ios/fastlane/.env.fastlane (see .env.fastlane.example) and retry.")
  end

  build_number = next_build_number
  Dir.chdir(FLUTTER_PROJECT_DIR) do
    sh(
      "flutter", "build", "ipa",
      "--build-number=#{build_number}",
      "--export-options-plist=ios/ExportOptions.plist",
      "--dart-define=FLAVOR_NAME=#{flavor}",
      "--dart-define=API_ROOT=#{api_root}",
      "--dart-define=SENTRY_DSN=#{sentry_dsn}"
    )
  end
  build_number
end

# Upload the freshly-built IPA to TestFlight and assign it to the internal
# group(s) in TESTFLIGHT_INTERNAL_GROUPS. Internal distribution needs no
# review and is reliable.
#
# We deliberately do NOT auto-distribute to the external group here.
# "LNDGRB external" is a public-link group, and fastlane's
# `distribute_external: true` silently fails to add builds to it — the build
# lands BETA_APPROVED but never becomes a member, while fastlane still logs
# "distributed". So external release is a manual step in App Store Connect
# (adding the group by hand is the thing that actually sticks); `beta` prints
# a reminder with the build number.
def upload_to_internal
  groups = ENV.fetch("TESTFLIGHT_INTERNAL_GROUPS", "").split(",").map(&:strip).reject(&:empty?)

  upload_to_testflight(
    api_key: asc_api_key,
    ipa: find_ipa,
    groups: groups,
    distribute_external: false,
    # Sets the build's "What to Test"; override per-build via TESTFLIGHT_CHANGELOG.
    changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Bug fixes and improvements."),
    skip_waiting_for_build_processing: false
  )
end

platform :ios do
  # Fastlane's default failure banner scrolls off the top of the
  # terminal during long IPA builds — make it impossible to miss by
  # firing a macOS notification (pops up in Notification Center) and
  # a spoken cue. `terminal-notifier` is bundled with fastlane so
  # the `notification` action works out of the box
  after_all do |lane|
    UI.header("✅ #{lane} succeeded")
    notification(
      title: "LANDGRAB #{lane}",
      subtitle: "Succeeded",
      message: "Build + upload complete."
    )
  end

  error do |lane, exception|
    UI.header("❌ #{lane} FAILED")
    UI.error(exception.message)
    notification(
      title: "LANDGRAB #{lane}",
      subtitle: "FAILED",
      message: exception.message.lines.first.to_s.strip
    )
  end

  desc "Push App Store Connect listing metadata (name, subtitle, description, etc.) without uploading a build."
  desc "Reads from fastlane/metadata/<locale>/<field>.txt — only files present get pushed; everything else stays as-is in App Store Connect."
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "ca.chromatin.poles",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  # The ATTENDEE build. Named `beta` to match Android. It builds the
  # production flavor (real server, env switcher hidden) and uploads to
  # TestFlight *internal* testers only — external release to attendees is a
  # deliberate manual step in App Store Connect (see upload_to_internal for
  # why). There's no `production`/store-release lane: we're not releasing
  # publicly. There's also no longer an `alpha`/staging lane — every
  # TestFlight build is now production, so "the latest build" is never a
  # staging one, and any build is safe to promote to attendees.
  desc "Build the production (attendee) app and upload to TestFlight internal testers."
  desc "External release is manual: App Store Connect → TestFlight → the build → add the 'LNDGRB external' group (see the printed reminder)."
  lane :beta do
    build_number = flutter_build_ipa(
      flavor: "production",
      api_root: PRODUCTION_API_ROOT,
      sentry_dsn: ENV.fetch("SENTRY_DSN", "")
    )
    upload_to_internal
    UI.header("Build #{build_number} uploaded — internal testers have it now")
    UI.important("To release to attendees, in App Store Connect:")
    UI.important("  TestFlight → Build #{build_number} → add group 'LNDGRB external'.")
    UI.important("(Auto-distribute to that public-link group is unreliable, so this stays manual on purpose.)")
  end
end
