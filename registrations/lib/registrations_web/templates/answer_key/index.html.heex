<%# Admin-only answer key. Styles are inlined rather than added to the
    player-facing SCSS bundle — this page is a utility printout, not
    part of the site's look. %>
<style>
  .answer-key .pole-card {
    background: white;
    color: black;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    break-inside: avoid;
  }
  .answer-key .pole-card svg { max-width: 100%; }
  .answer-key .barcode-text {
    font-family: monospace;
    font-size: 0.9rem;
    margin-top: -0.25rem;
  }
  .answer-key table { width: 100%; margin-top: 0.75rem; }
  .answer-key td, .answer-key th { vertical-align: top; }
  .answer-key .answer { font-family: monospace; white-space: pre-wrap; }
  .answer-key .meta { font-size: 0.8rem; color: #555; }
  .answer-key .owner { font-size: 0.9rem; margin: 0.25rem 0; }
  .answer-key .owner.unclaimed { color: #777; font-style: italic; }
  @media print {
    nav, .row.title, footer { display: none !important; }
    .answer-key .pole-card { border: none; border-bottom: 1px solid #999; }
  }
</style>

<div class="answer-key">
  <div class="row card">
    <div class="small-12 columns">
      <h2>Answer key</h2>
      <p class="meta">
        <%= length(@poles) %> poles ·
        <%= Enum.sum(for p <- @poles, do: length(p.puzzlets)) %> attached puzzlets ·
        <%= length(@withdrawn_poles) %> withdrawn ·
        <%= length(@retired_poles) %> retired ·
        <%= length(@unattached) %> unattached
      </p>
    </div>
  </div>

  <%= for pole <- @poles do %>
    <%= render "pole_card.html", pole: pole, owners: @owners %>
  <% end %>

  <%= if @withdrawn_poles != [] do %>
    <div class="pole-card">
      <details>
        <summary>
          <h3>Withdrawn by the endgame (<%= length(@withdrawn_poles) %>)</h3>
        </summary>
        <p class="meta">
          These stakes are outside the current endgame radius — off the players'
          maps and unclaimable — but kept here so the key stays complete.
        </p>
        <%= for pole <- @withdrawn_poles do %>
          <%= render "pole_card.html", pole: pole, owners: @owners %>
        <% end %>
      </details>
    </div>
  <% end %>

  <%= if @retired_poles != [] do %>
    <div class="pole-card">
      <details>
        <summary>
          <h3>Retired (<%= length(@retired_poles) %>)</h3>
        </summary>
        <p class="meta">
          These stakes have been retired — out of play for good — but kept here
          so the key stays complete.
        </p>
        <%= for pole <- @retired_poles do %>
          <%= render "pole_card.html", pole: pole, owners: @owners %>
        <% end %>
      </details>
    </div>
  <% end %>

  <%= if @unattached != [] do %>
    <div class="pole-card">
      <details>
        <summary>
          <h3>Unattached puzzlets</h3>
        </summary>
        <table>
          <thead>
            <tr>
              <th>Question</th>
              <th>Answer</th>
              <th>Meta</th>
            </tr>
          </thead>
          <tbody>
            <%= for puzzlet <- @unattached do %>
              <tr>
                <td><%= puzzlet.instructions %></td>
                <td class="answer">
                  <%= if puzzlet.answer_type == :barcode do %>
                    <%= answer_code_svg(puzzlet.answer, height: 40) %>
                    <p class="barcode-text"><%= puzzlet.answer %></p>
                  <% else %>
                    <%= puzzlet.answer %>
                  <% end %>
                </td>
                <td class="meta">
                  difficulty <%= puzzlet.difficulty %> · <%= puzzlet.answer_type %> · <%= puzzlet.status %>
                  <%= if puzzlet.validator_only do %>
                    · ★ validators only
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </details>
    </div>
  <% end %>
</div>
