<%# One pole's answer-key card: name, owner, scannable barcode, and its
    attached puzzlets' questions + answers. Rendered both for live poles and
    (inside a <details>) for poles the endgame boundary has withdrawn.
    Assigns: @pole, @owners. %>
<div class="pole-card">
  <h3><%= pole_name(@pole) %></h3>
  <%= case @owners[@pole.id] do %>
    <% nil -> %>
      <p class="owner unclaimed">Unclaimed</p>
    <% team -> %>
      <p class="owner">
        Held by <strong><%= team.name %></strong>
        (<%= member_usernames(team) %>)
      </p>
  <% end %>
  <%= barcode_svg(@pole.barcode) %>
  <p class="barcode-text"><%= @pole.barcode %></p>

  <%= if @pole.puzzlets == [] do %>
    <p class="meta">No puzzlets attached.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Question</th>
          <th>Answer</th>
          <th>Meta</th>
        </tr>
      </thead>
      <tbody>
        <%= for puzzlet <- @pole.puzzlets do %>
          <tr>
            <td><%= puzzlet.instructions %></td>
            <td class="answer">
              <%= if puzzlet.answer_type == :barcode do %>
                <%= barcode_svg(puzzlet.answer, height: 40) %>
                <p class="barcode-text"><%= puzzlet.answer %></p>
              <% else %>
                <%= puzzlet.answer %>
              <% end %>
            </td>
            <td class="meta">
              difficulty <%= puzzlet.difficulty %> ·
              <%= puzzlet.answer_type %> ·
              <%= puzzlet.status %>
              <%= if puzzlet.validator_only do %>· ★ validators only<% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
