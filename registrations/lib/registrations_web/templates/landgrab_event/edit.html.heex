<div class="row card">
  <div class="small-12 columns">
    <h2>Landgrab event</h2>

    <p>
      <strong>Started:</strong>
      <%= cond do %>
        <% is_nil(@event.start_time) -> %>
          no (start time not set)
        <% DateTime.compare(DateTime.utc_now(), @event.start_time) == :lt -> %>
          not yet (begins <%= format_local(@event.start_time) %>)
        <% true -> %>
          yes (began <%= format_local(@event.start_time) %>)
      <% end %>
    </p>

    <.form let={f} for={@changeset} action={Routes.landgrab_event_path(@conn, :update)}>
      <%= if @changeset.action do %>
        <div class="alert alert-danger">
          <p>Oops, something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <%= label(f, :name) %>
      <%= text_input(f, :name) %>
      <%= error_tag(f, :name) %>

      <br />

      <%= label(f, :start_time, "Start time (#{event_timezone()}, blank to unset)") %>
      <%= datetime_local_input(f, :start_time,
        value: local_input_value(Ecto.Changeset.get_field(@changeset, :start_time))
      ) %>
      <%= error_tag(f, :start_time) %>

      <br />

      <h3>Homepage note (HTML)</h3>
      <p class="meta">
        Shown on the public LANDGRAB page, just below the “visiting scholar
        Sabuk” line. Leave blank to hide it. Written as raw HTML and rendered
        as-is — keep it to trusted markup.
      </p>
      <%= textarea(f, :homepage_html, rows: 6) %>
      <%= error_tag(f, :homepage_html) %>

      <br />

      <h3>Endgame boundary</h3>
      <p class="meta">
        A capture boundary that shrinks toward the wrap-party spot,
        herding everyone there. Set all six fields or none. When the
        shrink begins, a SYSTEM message goes to every team
        automatically (within a minute).
      </p>

      <%= label(f, :endgame_latitude, "Centre latitude (wrap party)") %>
      <%= number_input(f, :endgame_latitude, step: "any") %>
      <%= error_tag(f, :endgame_latitude) %>

      <%= label(f, :endgame_longitude, "Centre longitude") %>
      <%= number_input(f, :endgame_longitude, step: "any") %>
      <%= error_tag(f, :endgame_longitude) %>

      <%= label(f, :endgame_starts_at, "Shrink starts (#{event_timezone()})") %>
      <%= datetime_local_input(f, :endgame_starts_at,
        value: local_input_value(Ecto.Changeset.get_field(@changeset, :endgame_starts_at))
      ) %>
      <%= error_tag(f, :endgame_starts_at) %>

      <%= label(f, :endgame_ends_at, "Shrink ends (#{event_timezone()})") %>
      <%= datetime_local_input(f, :endgame_ends_at,
        value: local_input_value(Ecto.Changeset.get_field(@changeset, :endgame_ends_at))
      ) %>
      <%= error_tag(f, :endgame_ends_at) %>

      <%= label(
        f,
        :endgame_initial_radius_m,
        "Initial radius (metres — cover the whole play area)"
      ) %>
      <%= number_input(f, :endgame_initial_radius_m, step: "any") %>
      <%= error_tag(f, :endgame_initial_radius_m) %>

      <%= label(f, :endgame_final_radius_m, "Final radius (metres)") %>
      <%= number_input(f, :endgame_final_radius_m, step: "any") %>
      <%= error_tag(f, :endgame_final_radius_m) %>

      <br />

      <h3>Bedab’s endgame messages</h3>
      <p class="meta">
        Sent from Bedab once the game ends (the shrink’s end), one message per
        team. Teams that joined the subversion get the precise location;
        everyone else gets the vaguer nudge. Read at send time, so you can keep
        editing until then — but they go out only once. Leave a box blank to
        send nothing to that group.
      </p>

      <%= label(f, :final_message_joined, "To teams that joined the subversion (precise location)") %>
      <%= textarea(f, :final_message_joined, rows: 4) %>
      <%= error_tag(f, :final_message_joined) %>

      <%= label(f, :final_message_others, "To everyone else (vaguer nudge)") %>
      <%= textarea(f, :final_message_others, rows: 4) %>
      <%= error_tag(f, :final_message_others) %>

      <br />

      <div>
        <%= submit("Save", class: "button") %>
      </div>
    </.form>
  </div>
</div>
