<% {vb_w, vb_h} = RegistrationsWeb.Landgrab.view_box() %>
<div class="landgrab-hero">
  <div class="landgrab-stage">
    <svg
      class="landgrab-map"
      viewBox={"0 0 #{vb_w} #{vb_h}"}
      preserveAspectRatio="xMaxYMax slice"
      aria-hidden="true"
    >
      <rect width={vb_w} height={vb_h} fill="#0a0a0a" />
      <g class="landgrab-grid" fill="#161616">
        <%= for col <- 0..19 do %>
          <%= for row <- 0..11 do %>
            <circle cx={col * 42 + 12} cy={row * 42 + 12} r="0.7" />
          <% end %>
        <% end %>
      </g>

      <g
        class="landgrab-rivers-casing"
        fill="none"
        stroke="#11283d"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <%= for river <- RegistrationsWeb.Landgrab.rivers() do %>
          <path
            d={river["path"]}
            data-river-id={river["id"]}
            data-river-name={river["name"]}
            stroke-width={RegistrationsWeb.Landgrab.casing_width(river["name"])}
          />
        <% end %>
      </g>
      <g
        class="landgrab-rivers"
        fill="none"
        stroke="#2d6a9f"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <%= for river <- RegistrationsWeb.Landgrab.rivers() do %>
          <path
            d={river["path"]}
            data-river-id={river["id"]}
            data-river-name={river["name"]}
            stroke-width={RegistrationsWeb.Landgrab.stroke_width(river["name"])}
          />
        <% end %>
      </g>

      <g class="landgrab-poles"></g>
    </svg>

    <div class="landgrab-wordmark" aria-label="LANDGRAB">
      <%= render("landgrab_wordmark.html", assigns) %>
      <span class="landgrab-wordmark-subtitle"><%= phrase("description") %></span>
    </div>
    <div class="landgrab-scroll-hint" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </div>
  </div>
</div>

<div class="row card landgrab-storyline">
  <div class="small-12 columns">
    <p>
      Visiting scholar Sabuk, leading expert on the sociology of colonial-era settler formations, is running a simulation in Wînipêk. Saturday, July 25, 1pm, downtown.
    </p>
  </div>
</div>

<%= if @placeholder do %>
  <%= unless @hide_waitlist do %>
    <div class="row card" data-test-placeholder>
      <div class="small-12 columns">
        <h2>express intern interest</h2>
        <p>
          Enter your email address to learn when the site goes live.
        </p>
        <%= render(RegistrationsWeb.SharedView, "waitlist.html", conn: @conn) %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="row highlight">
    <div class="small-12 columns">
      <h2>What is it, really?</h2>
      <p>
        <details>
          <summary>Spoil me</summary>
          It’s an interactive puzzle-solving <a href="https://events.chromatin.ca/">adventure</a>,
          a game akin to a scavenger hunt.
          Teams will use a custom app that sends them to find things around the area to “capture” territory. The site is in character and therefore cryptic but use the form
          below if you have questions.
        </details>
      </p>
    </div>
  </div>

  <div class="row card">
    <div class="small-12 columns">
      <h2 class="moving-highlight">
        Accessibility
      </h2>
      <p>
        Do you have accessibility needs we should know about? Please tell us <%= link(
          "when you register",
          to: Routes.pow_registration_path(@conn, :new)
        ) %> and we will work with you to ensure you can participate.
      </p>
    </div>
  </div>

  <div class="row card">
    <div class="small-12 columns">
      <h2>Questions</h2>
      <%= render(RegistrationsWeb.SharedView, "question.html", conn: @conn) %>
    </div>
  </div>
<% end %>
