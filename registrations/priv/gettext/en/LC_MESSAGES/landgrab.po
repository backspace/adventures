# ─── Accessibility tags ─────────────────────────────────────────────
# Rendered under each chip on /details. The mobile app has its own,
# out-of-storyline versions in `landgrab_app/lib/models/accessibility.dart`
# — the two deliberately diverge, since one addresses participants
# in-fiction and the other addresses authors managing content.

msgid "accessibility_tag.stairs.label"
msgstr "No stairs"

msgid "accessibility_tag.stairs.help"
msgstr "Some locations are reached via stairs."

msgid "accessibility_tag.strenuous.label"
msgstr "Nothing too strenuous"

msgid "accessibility_tag.strenuous.help"
msgstr "Some locations take sustained effort to reach — several flights of stairs, for instance — even where each step is manageable."

msgid "accessibility_tag.steep.label"
msgstr "No steep incline"

msgid "accessibility_tag.steep.help"
msgstr "Some approaches involve a significant hill or ramp."

msgid "accessibility_tag.heights.label"
msgstr "No heights"

msgid "accessibility_tag.heights.help"
msgstr "Some observations take place at height — rooftops, balconies, or other elevated vantages."

msgid "accessibility_tag.uneven_surface.label"
msgstr "No uneven ground"

msgid "accessibility_tag.uneven_surface.help"
msgstr "Some routes cross gravel, cobblestones, grass, dirt, or broken pavement."

msgid "accessibility_tag.narrow_path.label"
msgstr "No narrow passage"

msgid "accessibility_tag.narrow_path.help"
msgstr "Some approaches pass through a corridor or doorway too narrow for a wheelchair or stroller."

msgid "accessibility_tag.dim_lighting.label"
msgstr "No low light"

msgid "accessibility_tag.dim_lighting.help"
msgstr "Some locations or approaches are poorly lit, especially after dark."

msgid "accessibility_tag.crouch_required.label"
msgstr "No crouching"

msgid "accessibility_tag.crouch_required.help"
msgstr "Some observations require bending or crouching to inspect something at a low level."

msgid "accessibility_tag.reach_required.label"
msgstr "No reaching"

msgid "accessibility_tag.reach_required.help"
msgstr "Some observations require looking up or reaching for something elevated."

msgid "accessibility_tag.requires_hearing.label"
msgstr "No audio"

msgid "accessibility_tag.requires_hearing.help"
msgstr "Some observations rely on an audio cue."

msgid "accessibility_tag.requires_vision.label"
msgstr "No detailed vision"

msgid "accessibility_tag.requires_vision.help"
msgstr "Some observations require reading fine print, distinguishing colors, or other visual detail."

# ── In-game vocabulary ───────────────────────────────────────────────
# The single place to rename these words across every player-facing
# string — the server mirror of the Flutter app's `Terms` class
# (lib/l10n/player_strings.dart). The app_* strings below interpolate
# them (%{stake}, %{relic}, …); PlayerStrings.phrase/2 injects them into
# every lookup, so a rename here changes them everywhere at once. The
# internal words "pole"/"puzzlet" must never appear literally below.
msgid "term_stake"
msgstr "stake"

msgid "term_stakes"
msgstr "stakes"

msgid "term_stake_cap"
msgstr "Stake"

msgid "term_stakes_cap"
msgstr "Stakes"

msgid "term_relic"
msgstr "relic"

msgid "term_relics"
msgstr "relics"

msgid "term_relic_cap"
msgstr "Relic"

# ── Player-facing copy ───────────────────────────────────────────────
# %{pole} / %{captor} / %{attacker} / %{team} / %{title} are dynamic
# values (a stake's NAME, a team name, …), not vocabulary.
msgid "app_attack_body"
msgstr "%{attacker} scanned %{pole}"

msgid "app_attack_body_unknown"
msgstr "A rival team scanned %{pole}"

msgid "app_pole_lost_body"
msgstr "%{captor} captured %{pole} from you"

msgid "app_pole_lost_body_unknown"
msgstr "A rival team captured %{pole} from you"

msgid "app_puzzlet_taken_body"
msgstr "%{captor} solved the %{relic} you were working on."

msgid "app_puzzlet_taken_body_unknown"
msgstr "Another team solved the %{relic} you were working on."

msgid "app_puzzlet_withdrawn_body"
msgstr "A %{relic} you were working on has been withdrawn from the study."

msgid "app_pole_contested_body"
msgstr "%{team} is now working on %{pole} too — it's a race."

msgid "app_pole_contested_body_unknown"
msgstr "Another team is now working on %{pole} too — it's a race."

msgid "app_endgame_announcement"
msgstr "ANOMALY DETECTED. %{stakesCap} at the periphery are being withdrawn from the simulation. Withdrawn %{stakes} disappear from your map. Claims are only accepted on %{stakes} still shown."

