msgstr "Under attack"

msgid "app_push_title_pole_lost"
msgstr "%{stakeCap} lost"

msgid "app_push_title_puzzlet_taken"
msgstr "%{relicCap} taken"

msgid "app_push_title_puzzlet_withdrawn"
