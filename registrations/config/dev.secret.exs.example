import Config

# Copy this file to `config/dev.secret.exs` and fill in the real
# values. `dev.secret.exs` is gitignored; this template is committed
# to advertise what a working dev setup expects.
#
# Structural / non-secret dev config lives in `config/dev.exs`,
# including the optional local HTTPS listener (activated via the
# `LOCAL_HOSTNAME` env var — see the block near the bottom of that
# file).

# Outgoing mail. In dev you can either use the same Mailgun sandbox
# domain shared with the team, or swap to `Swoosh.Adapters.Local`
# for a browser-based inbox at `/dev/mailbox`.
config :registrations, Registrations.Mailer,
  adapter: Swoosh.Adapters.Mailgun,
  api_key: "REPLACE_WITH_MAILGUN_API_KEY",
  domain: "REPLACE_WITH_MAILGUN_SANDBOX_DOMAIN"

# OAuth providers wired through PowAssent. Only add the ones you're
# actively developing against; each backs a "Sign in with …" button
# on the site's login form and (for google / apple) in the mobile
# app. Callback URLs to register with each provider — for a Tailscale
# HTTPS setup those look like
# `https://<LOCAL_HOSTNAME>:4443/auth/<provider>/callback` for the
# site and `.../powapi/auth/<provider>/mobile_bounce` for the app.
config :registrations, :pow_assent,
  providers: [
    # github: [
    #   client_id: "REPLACE_ME",
    #   client_secret: "REPLACE_ME",
    #   strategy: Assent.Strategy.Github
    # ],
    # google: [
    #   client_id: "REPLACE_ME.apps.googleusercontent.com",
    #   client_secret: "REPLACE_ME",
    #   strategy: Assent.Strategy.Google
    # ]
  ]

# Which adventure the running server is serving. Determines templates,
# gettext domain, and (in newer code) route wiring. Options include
# `"clandestine-rendezvous"`, `"landgrab"`, `"unmnemonic-devices"`,
# and `"waydowntown"`.
config :registrations,
  adventure: "landgrab"
